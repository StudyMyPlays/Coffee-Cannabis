# Coffee & Cannabis Club — environment variables
# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# ---------------------------------------------------------------- Site
# Canonical public URL, no trailing slash. Used for links in emails/RSVP
# cancel URLs and metadata. If unset, Vercel's production domain
# (VERCEL_PROJECT_PRODUCTION_URL, set automatically) is used, else localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Require a mobile number on the founding-member form ("true" / unset).
NEXT_PUBLIC_MOBILE_REQUIRED=false

# Google Analytics 4 measurement ID (optional; analytics off when unset).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------- Data
# Which data adapter to use. Only "local" exists today (JSON files).
# Content: content/*.json (git). Runtime (members/RSVPs): .data/ locally,
# EPHEMERAL os tmpdir on Vercel. See docs/CMS.md.
DATA_ADAPTER=local
# Future database adapter (not implemented yet — see src/lib/data/index.ts):
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Admin
# Shared team password for /admin. Admin is disabled when unset.
ADMIN_PASSWORD=
# Optional extra secret for signing admin session cookies (long random string,
# e.g. `openssl rand -base64 32`). If unset, it's derived from ADMIN_PASSWORD.
# Changing either one signs everyone out.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------- Notifications
# Webhook that receives every event as JSON {event, payload, sentAt}
# (Zapier/Make catch hook, or your own Resend/Twilio/Klaviyo bridge).
# When unset, events are only logged.
NOTIFY_WEBHOOK_URL=
# Signs webhook bodies: header x-ccc-signature: sha256=<HMAC-SHA256 hex>.
NOTIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Spam
# Cloudflare Turnstile secret. When set, /api/join and /api/rsvp require a
# valid `turnstileToken` in the request body (the form must render the widget).
# TURNSTILE_SECRET_KEY=
# Public site key for the widget (only needed if the UI renders Turnstile).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------- Cron
# Protects /api/cron/reminders. Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
# automatically when this is set in the project. Long random string.
CRON_SECRET=
